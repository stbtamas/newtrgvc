{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newtrgvc-beta",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/community",
      "/community/*"
    ]
  },
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newtrgvc-beta-db",
      "database_id": "d1e9b8a7-6ed8-4c9b-aa44-0a22600d9653",
      "migrations_dir": "migrations"
    }
  ]
}
